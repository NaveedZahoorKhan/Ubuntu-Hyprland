// ### Minimal -SHORT ### //

{
"include": [
  "$HOME/.config/waybar/Modules",
  "$HOME/.config/waybar/ModulesWorkspaces",
  "$HOME/.config/waybar/ModulesCustom",
  "$HOME/.config/waybar/ModulesGroups",
  "$HOME/.config/waybar/UserModules",
  ],
"layer": "top",
"position": "top",
"exclusive": true,
"fixed-center": true,
"spacing": 3,
"margin-top": 3,

"modules-left": [
	"clock",  
	"custom/weather", 
	],

"modules-center": [
	"hyprland/workspaces#roman"
	],

"modules-right": [
	"custom/menu", 
	"custom/hint",
	"custom/cycle_wall",
	"custom/vpn",
	"tray",
	"group/notify",
	"mpris", 
	"network", 
	"bluetooth", 
	"backlight", 
	"pulseaudio", 
	"battery", 
	"custom/nightlight",
	"custom/power"],
}
