-def migrate_config(config_path: str = None) -> bool:
+def migrate_config(config_path: str = None, create_backup: bool = True, backup: bool = None) -> Dict[str, Any]:
     """Convenience function to migrate configuration."""
-    return migrate_user_config(config_path)
+    if backup is None:
+        backup = create_backup
+
+    if config_path is None:
+        config_path = Path.home() / ".config" / "hyprrice" / "config.yaml"
+    else:
+        config_path = Path(config_path)
+
+    if not config_path.exists():
+        logging.getLogger(__name__).info("No configuration file found, skipping migration")
+        return {"success": True, "migrated": False, "backup_path": None}
+
+    migrator = ConfigMigrator()
+    config_data = migrator.file_handler.safe_read_yaml(config_path)
+
+    if not migrator.needs_migration(config_data):
+        return {"success": True, "migrated": False, "backup_path": None}
+
+    backup_path = None
+    if backup:
+        backup_path = migrator._create_backup(config_path)
+        logging.getLogger(__name__).info(f"Created backup: {backup_path}")
+
+    migrated_data = migrator.migrate_config(config_data)
+    migrator.file_handler.safe_write_yaml(migrated_data, config_path)
+
+    return {
+        "success": True,
+        "migrated": True,
+        "backup_path": str(backup_path) if backup_path else None,
+    }
 
 
